{
  "name": "motasadi-platform",
  "version": "1.0.0",
  "private": true,
  "description": "املاک متصدی — وب‌سایت عمومی و پنل مدیریت املاک",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start:standalone": "node .next/standalone/server.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.28",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
