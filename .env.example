# ───── پایگاه داده ─────
# تولید (Production): PostgreSQL
# DATABASE_URL=postgres://motasadi_app:CHANGE_ME@localhost:5432/motasadi
# اجرای محلی بدون نصب PostgreSQL: پایگاه دادهٔ داخلی PGlite در پوشهٔ .data
# نکته: سرور standalone پوشهٔ کاری را به .next/standalone عوض می‌کند؛ در سرور مسیرها را مطلق بنویسید.
DATABASE_URL=pglite://./.data/db

# آدرس عمومی سایت، بدون اسلش انتهایی (برای sitemap، canonical و Open Graph)
SITE_URL=http://localhost:3000

# محل ذخیرهٔ فایل‌های آپلودی (عکس ملک، رسید). باید روی دیسک پایدار باشد و پشتیبان‌گیری شود.
UPLOAD_DIR=./uploads

# مدت اعتبار نشست ورود (ساعت)
SESSION_TTL_HOURS=12

# کوکی ورود فقط روی HTTPS ارسال شود. اگر تنظیم نشود، در production خودکار true است.
# فقط برای آزمایش محلی روی http و با build تولیدی، false بگذارید.
# COOKIE_SECURE=true

# حداکثر اتصال هم‌زمان به PostgreSQL
# DB_POOL_MAX=10
